# Aetrix 统一后端（含自建 Emby 服务器）环境配置示例
# 复制为 .env 并按需修改
#
# ==================== 先读这一段（授权客户） ====================
# 整套配置里**只有两行必须改**（DEPLOY.md 第 3 步的两条命令会自动改好）：
#   SECRET_KEY          会话签名密钥。泄露 = 别人能伪造你的登录态
#   POSTGRES_PASSWORD   数据库密码
#
# 其余全部保持默认就能跑起来。下面每一项都写了「改了会发生什么」，
# 不确定就别动 —— 环境变量配错是这套部署最常见的失败原因，而且报错往往
# 出现在容器日志深处，不会提示是哪一行配错了。
#
# 遇到问题先看 DEPLOY.md 第五节「常见问题」。

# ==================== 部署参数（授权客户最常改的几项）====================
# ---- 对外端口（这一项才是你要改的端口）----
# 宿主机上暴露给浏览器的端口（对外只走 nginx 这一入口）。改了记得同步客户端里的地址。
AETRIX_PORT=8000
# ⚠️ 改端口改 AETRIX_PORT，**不要**改下面这个 PORT：
# PORT / HOST 是容器**内部**监听端口，镜像里已固定为 8000，compose 不读它们。
# 写在这里不会有任何效果（改错了也不报错，只是你以为改了而已）。
# PORT=8000
# HOST=0.0.0.0

# 媒体库宿主机路径，挂进容器的 /media（只读）。指向你的影视库目录。
MEDIA_ROOT=./media
# 镜像版本标签。留空 = 跟随 ghcr.io 的 latest（永远是最新的稳定版）；
# 想能一句话回滚就填死版本号（如 2.42.10），然后 docker compose pull && up -d。
# 仅 docker-compose.prod.yml（授权版部署）用到；自建版走 build，不看这一项。
AETRIX_IMAGE_TAG=

# JWT 签名密钥（服务启动必填：至少 32 字符；EM 与 EA 必须一致）
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 仅一次性本地测试可设置 ALLOW_EPHEMERAL_SECRET=true 跳过缺失密钥检查；生产勿用
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# 推流节点共享密钥（安全修复：不再把 SECRET_KEY 发给节点）
# 面板与推流节点用此密钥做身份签名，两端必须一致且与 SECRET_KEY 不同
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# NODE_SHARED_SECRET=

# 播放签名 URL 有效期（秒），默认 21600（6 小时）
# PLAY_SIGN_URL_TTL=21600

# 播放地址的对外基址。只填根（https://media.example.com），不要带路径或查询串。
# 运行时只认字面以 http:// 或 https:// 开头的值，其它写法当成没配。代码不剥路径。
# 认得出时：PlaybackInfo 的 DirectStreamUrl / DirectPlayUrl / TranscodingUrl、字幕
# DeliveryUrl、本服务图片绝对地址、HLS、System/Info 的 LocalAddress/WanAddress 都用它，
# 不看 Host、不看转发头。反代后面 Host 往往是源站域名或源站 IP，写进播放地址会让客户端
# 打到只做 301 的 80 端口，或把源站地址泄漏出去。
# 门户账号卡在 EM 进程里解析，不在 EA 上：先看该服「对外地址」(realm.url)，再看「服务器」页的
# 服务入口；都空了才用本进程的这个变量。非默认服这两项都空则不下发地址。分离部署时 EM 与 EA
# 都要设；服对外地址或服务入口只代替 EM 这一侧。
# 启动时：已设置则必须以 https:// 开头（大小写不敏感）。域名守卫的名单是：流媒体加速开关
# 打开且填了域名时用那份域名，否则看 ENFORCE_DOMAIN；名单非空而主机不在里面会 WARNING。
# 不合规只记 WARNING，不阻止启动，也不因此停用运行时仍认的 http:// 地址。未设置不告警。
# 详见 docs/deploy-docker.md「客户端对外地址」。
EMBY_PUBLIC_URL=https://media.example.com
# 未设置或认不出时的回退：仅当 TCP 直连方属于 TRUSTED_PROXIES（默认含 127.0.0.0/8）
# 或 FORWARDED_ALLOW_IPS 里的精确 IP / CIDR，或这次请求已由可信代理还原出真实 IP 时，
# 才采信 X-Forwarded-Proto / X-Forwarded-Host；否则用 request.base_url。
# TLS 在 nginx 终结、对端是 Docker 网关且网关不在上述名单时，scheme 会变成 http，
# SenPlayer 不跟随 301。内置 Cloudflare 网段不自动算进这份播放地址信任名单。
# 不要写 FORWARDED_ALLOW_IPS=*。* 会让任意直连方用 X-Forwarded-For 伪造客户端 IP，
# 限流按这个 IP 分桶，按客户端 IP 做的访问判断也会被绕过。
# 域名守卫、公开 URL 的 scheme/host、以及 serve.py / serve_emby.py / backend/main.py /
# emby_api/main.py 传给 uvicorn 的名单都丢掉 *，每个进程只记一次 WARNING。
# 只剩 *、或这项没写时，uvicorn 只信回环 127.0.0.1,::1。同一行里的精确 IP / CIDR 仍有效。
# 升级（#1172 之后）：已经写成 * 的部署，升级后 uvicorn 只信回环。请改成网关的精确 IP
# 或网段（例如 FORWARDED_ALLOW_IPS=172.18.0.0/16），或把同一网段写进 TRUSTED_PROXIES。
# 两项都不改、又没设 EMBY_PUBLIC_URL 时，播放地址回退成 http。限流只在直连方属于
# TRUSTED_PROXIES 时才读 X-Real-IP / X-Forwarded-For；网关不在默认回环里，每个用户的
# IP 都会变成网关地址，正常用户共用一个限流桶。
# 注：EMBY_SERVER_ID 是客户端用来认服务器的身份，默认值随品牌改为 aetrix-emby-server。
# 升级上来的部署若没显式设过它，客户端会把服务器当成新的一台（重登一次即可）；想避免就保留旧值。
EMBY_SERVER_NAME=Aetrix Media Server
EMBY_SERVER_ID=aetrix-emby-server

# ==================== EM / EA 分离部署（可选，推荐生产使用）====================
# 默认单进程模式：EM（面板）自己一并提供 Emby 协议面，无需配置本节。
# 分离模式：EA（Emby API 网关）独立部署，客户端直连 EA；EM 只跑面板。详见 docs/deploy-ea.md
#
# EM 是否内置 Emby 协议面（false = 交给独立的 EA 服务）
ENABLE_EMBY_GATEWAY=true
# EA 监听端口（仅分离模式使用；EA 必须与 EM 共用 SECRET_KEY 与 DATABASE_URL）
# EMBY_API_PORT=8001
# 客户端应该连接的地址（EA 的对外地址），分离模式下 EM 用它给客户端指引
# EMBY_API_PUBLIC_URL=https://emby.example.com
# EM 面板地址（可选）：EA 启动后探测它是否可达，仅告警不阻断
# EM_PANEL_URL=https://panel.example.com
#
# ==== 多台 EA / 多个服（可选，一个面板同时运营多个服时用）====
# 一个后端服可以部署到多台服务器：每台机器跑一个 EA，各放自己碰得到的内容。
# 这两行都填在 **EA** 那台机器上（面板里给这台服务器指定的归属服优先于 REALM）：
# 节点标识：认领面板「服务器」里的一条 EA 记录，认领不到会自动登记一条
# NODE_KEY=node-a
# 属于哪个服（填服的 slug 或 id；不填则按面板里这台服务器的归属服）
# REALM=main
#
# EM 自带网关服务哪个服（一体化部署且分了多个服时才需要；留空 = 默认服）
# EM_GATEWAY_REALM=main

# ==================== 安全 ====================
# CORS 允许来源（逗号分隔；生产环境务必设置具体域名，留空则允许所有源）
# CORS_ORIGINS=https://panel.example.com,https://www.example.com
# 注：旧版「纯数字即 user_id」的 token 兼容开关（EMBY_ALLOW_LEGACY_TOKENS）已随代码移除，
# 设置它不再有任何效果。
#
# 节点共享密钥（EM ↔ EA / 推流节点之间互证身份用，**不是** SECRET_KEY）。
# 留空 = 由 SECRET_KEY 单向派生（两端 SECRET_KEY 一致即可互认，泄露它也签不出 JWT）。
# 部署脚本 / curl 的 X-Panel-Key 填的就是它；查看本机的值: python -m backend.node_auth
# EM、EA 与所有推流节点必须一致。
# NODE_SHARED_SECRET=
# 节点签名允许的时钟误差（秒，默认 300）：两端时间差超过它签名就会被拒，请开 NTP
# NODE_AUTH_MAX_SKEW=300
# 网页播放器签名播放链接的有效期（秒，默认 21600 = 6 小时）；过期后刷新页面即可重新签发
# PLAY_SIGN_URL_TTL=21600

# ==================== 数据库 ====================
# v2.42.0 起**默认 PostgreSQL**。SQLite 只在单进程/单机场景够用：写锁模型下
# 扫描、播放上报、订单并发容易撞 "database is locked"，备份也只能做文件级快照。
# Compose 部署会自动拉起 postgres，不需要你手改任何一项。
#
# ⚠️ 这里**故意不写** DATABASE_URL。
#
# 连接串由 docker-compose.prod.yml 自己拼（它内部已经会引用下面的
# POSTGRES_PASSWORD）。曾经这里写过一行带字面密码的 DATABASE_URL，那是错的：
# 客户按 DEPLOY.md 改了 POSTGRES_PASSWORD 之后，两边密码就再也对不上，
# 后端一直报 `password authentication failed for user "aetrix"`，
# 容器反复重启，而错误信息里完全看不出是哪一行配置配错了。
#
# 如果你**非**要改连接串（比如换数据库主机/端口），请在 .env 里写**完整**的一行：
#   DATABASE_URL=postgresql://aetrix:<与下面相同的密码>@postgres:5432/aetrix
# 密码必须与 POSTGRES_PASSWORD 一致；两者只能改一处，不要只改其中一边。
DATABASE_TYPE=postgresql
# 数据库密码（compose 用它初始化 PG 账号，也用它拼上面的连接串）。
# 保持默认能跑起来，但**生产必须改**（DEPLOY.md 第 3 步的 sed 会自动生成随机值）。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=aetrix
# 数据库名 / 账号（除非你部署了多套，否则不用改）
POSTGRES_USER=aetrix
POSTGRES_DB=aetrix
# 连接池（每个进程）。api / worker / EA 三个进程各持一个 engine，
# 峰值连接数 = 3 × (DB_POOL_SIZE + DB_MAX_OVERFLOW)。
# 注意：生产 docker-compose.yml 里 DB_MAX_OVERFLOW 实际是 ${DB_MAX_OVERFLOW:-25}
# （不是这里示例的 10），生产峰值 = 3 × (25 + 25) = 150；
# 请确保 PG 的 max_connections 有富余（生产 200；默认 100 不够，需同步调高）。
# 环境变量专供：管理后台不可改。
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=10
#
# SQLite 仅保留给老部署兜底（要继续用必须显式写下面两行）：
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite:///./aetrix_unified.db

# ==================== Redis ====================
# ⚠️ compose 部署请**保持 true**，不要改成 false。
#
# compose 会拉起 redis 容器，aetrix-api 的健康检查直接断言 Redis 里有 worker 心跳；
# 而后端在 REDIS_ENABLED=false 时会让 worker **拒绝启动**（单实例锁与扫描队列
# 都依赖它）。也就是说在 compose 部署下 false 不是「关掉缓存、跑得更快」，
# 而是服务永远不健康、依赖它的前端一直等不起 —— 首次启动会卡在 waiting。
#
# 只有「不用 compose、自己直接跑 python 进程」的单机测试才可能需要 false，
# 那时也不需要 redis 容器。
REDIS_ENABLED=true
# Redis 地址。compose 内部已固定为 redis:6379/0 并自带 redis 容器，不用改。
REDIS_URL=redis://redis:6379/0

# ==================== Emby 媒体库 ====================
# 本地缓存根（图片/TMDB/字幕缓存默认落这里；转码删除后不再有转码工作目录）
#EMBY_CACHE_DIR=/tmp/aetrix_cache
# ffmpeg 路径（仅供内封字幕抽取与缩略图抽帧；服务端视频转码已删除）
EMBY_FFMPEG_PATH=ffmpeg

# ==================== 元数据刮削 ====================
# TMDB API Key（申请: https://www.themoviedb.org/settings/api）
# 支持多密钥轮询：逗号分隔，某个密钥超配额（429）时自动轮到下一个
TMDB_API_KEY=
# TMDB_API_KEYS=key1,key2,key3
TMDB_LANGUAGE=zh-CN

# 刮削图片本地化（v2.17.0）：把海报/背景图落一份到本机，客户端不再每次由服务器
# 去 TMDB 拉一趟（源站慢/被限速时媒体库封面不再跟着抖）。远程地址始终保留，
# 缓存文件被清掉会按需自愈，落不下来就退回原来的代理。默认开启。
# EMBY_LOCALIZE_IMAGES=0
# 图片缓存目录（默认 <EMBY_CACHE_DIR>/images；这是缓存，可被清空）
# EMBY_IMAGE_DIR=/var/lib/aetrix/images
# 缓存上限（MB，默认 2048）：超出时从旧到新淘汰没被任何条目引用的图
# EMBY_IMAGE_CACHE_MB=2048
# 新增文件保护期（秒，默认 3600）：刚落盘还没写库的文件不会被清理
# EMBY_IMAGE_GRACE_SECONDS=3600
# 单张图下载超时（秒，默认 15）
# EMBY_IMAGE_TIMEOUT=15
# 缩略图（海报墙提速）：原图落盘后后台生成小尺寸 JPEG，图片接口按需下发。
# EMBY_THUMB_WIDTHS=160,320,640  宽度档（逗号分隔）。
#   这不只是"预热哪些尺寸"，更是**变体文件数的上界**：请求宽度会被吸附到
#   最近的档位上（就近取不小于请求值的最小档），所以每个原图最多生成
#   档位数个变体。档位越少越省磁盘，但偏离真实使用宽度越多，缩放损耗越大。
#   160=列表行，320=卡片，640=详情/背景。
#   改这个值前请同步前端实际请求的宽度（否则预热命中率低，档位白设）。
# EMBY_THUMB_MAX_DIM=4096     单次请求允许的最大边长（超出钳制，防滥用）
# EMBY_THUMB_MAX_MEGAPIXELS=25  原图超过 25MP 直接拒绝转码（解码太吃内存）
# EMBY_THUMB_CONCURRENCY=4    同时转码的缩略图数（信号量，海报墙/预热/补生成共用）
#   抢不到名额时直接回原图、**不排队**——这些函数跑在 Starlette 的 anyio
#   线程池里（默认 40），排队会把其它同步端点的线程全占光，整站假死。
# EMBY_IMAGE_DL_CONCURRENCY=8  同时进行的远程图片下载数（同理：超时默认 15s，
#   排队等同拖死线程池；抢不到就退回远程地址）
# EMBY_THUMB_MEM_MB=32        缩略图内存缓存总量上限（MB，0=关闭）
# 刮削期图片预热（v2.54.0，默认关）：开=刮削时同步把图片下载到本地（旧行为，
#   刮削一条条目典型多 2~15 次网络请求、约占耗时九成）；关=刮削只落远程地址，
#   本地文件由下面的补下载巡检后台慢慢补齐、看图时按需兜底（自愈/代理回退）。
#   注意：手动「重新生成图片」等显式修复路径不受本开关影响。
# EMBY_IMAGE_PREWARM=1
# 图片补下载巡检（v2.54.0，默认开）：janitor 每轮把「有远程地址但本地文件缺失」
#   的条目补下载落盘，id 倒序新入库优先，单轮上限 60 条；下载失败进程内冷却
#   1800 秒不反复重试。关了则新条目的图只走取图时按需自愈。
# EMBY_IMAGE_BACKFILL=0

# ==================== 扫描（资源预算 / 增量） ====================
# SCAN_BATCH=400            每批文件数（批量查库 / 落盘的粒度），小内存机器可调小
# SCAN_WORKERS=4            并行 IO 线程数（探测 / 目录 / TMDB）
# SCAN_INCREMENTAL=0        关掉目录指纹增量扫描（回到每次全量处理；默认开启）
# SCAN_CLEANUP_BATCH=5000   清理阶段每批读多少条目（不碰 IO，批越大越省往返）
# SCAN_IO_NICE=10           探测子进程（ffprobe）的 niceness，0 = 关闭；
#                           有 ionice 时同时把 IO 优先级降到 best-effort 最低档。
#                           nice 是进程级的，所以只降子进程（降本进程会连播放一起降）。
#                           注意：设为空串 = 按默认值 10 处理（R18 语义，旧版空串曾按 0 处理）。
#                           想彻底关闭请显式设为 0。
# EMBY_SCAN_HISTORY=20      每个媒体库保留多少轮扫描记录（后台「记录」抽屉里看）；
#                           0 = 不记。一轮一行，超过就回收最旧的行，媒体库删除后由维护周期收掉。
#
# 扫描队列（v2.27.0）：四个库同一个分钟里点扫描时，旧行为是四个任务一起打同一个远程
# 挂载（远端延迟被放大、CPU 打满而进度不动）。现在入队、按远程挂载串行化：
# EMBY_SCAN_QUEUE=0          关掉队列（回到「谁点谁起线程」，仍会上报进度）；默认开启
# EMBY_SCAN_MAX_PARALLEL=2   同时最多跑几个扫描（队列关闭时无效）
# EMBY_SCAN_MOUNT_SERIAL=0   关掉「同一远程挂载串行」（不建议：这正是那个瓶颈的根因修复）
# EMBY_SCAN_QUEUE_HISTORY=12 后台队列面板保留多少条刚跑完的记录
# EMBY_SCAN_PROGRESS_FLUSH=2 扫描进行中的进度每几秒落盘一次（刷新页面 / 另一个进程也能看到）
#
# 远程请求并发上限（v2.27.0，默认 2）：同时最多几个远程目录列举在飞。
# 远程来源（115 / rclone）在高并发下不会更快（要么排队要么限流），本机目录不吃这个名额。
# MOUNT_REMOTE_CONCURRENCY=2
# 追新（chase-new）的**独立**远程名额（默认 1）：追新是低频后台任务，扫描是主任务，
# 所以给它一个更小的名额，两者互不抢。不设也能跑，2026-10 起追新已走公共通道。
# CHASE_REMOTE_CONCURRENCY=1
# 追新往季目录里最多往下钻几层 / 单个季目录最多收多少条目（防异常结构把遍历拖死）
# CHASE_MAX_DEPTH=3
# CHASE_MAX_ENTRIES=5000

# ==================== 媒体库 / 搜索 / 刮削 ====================
# 按发行平台（Netflix / Disney+ / Apple TV+ / Prime Video / Max / Hulu /
# Paramount+ / Peacock / Crunchyroll）自动生成的虚拟媒体库总开关。
# 关闭时虚拟库既不出现在客户端媒体库列表里，用 guid 直达也返回 404。
# 每台 EA 可独立配置（分离部署时在 EA 侧设），默认开启。
ENABLE_VIRTUAL_LIBRARIES=true

# 前端构建产物目录（一般不用改）
# 用户门户与后台的构建产物路径是固定约定：user_frontend/dist 与 admin_frontend/dist。
# 只有把产物构建到别处（如镜像里另存一份）时才需要覆盖；部署自检也按这两个变量判定。
# FRONTEND_DIST=/opt/aetrix/user_frontend/dist
# ADMIN_DIST=/opt/aetrix/admin_frontend/dist

# ==================== 115 直挂（v2.18.0：只留账号 + 直挂） ====================
# 115 以「存储挂载」的形式接入（类型选 115）：面板 / EA 用 Cookie 型 Web API 列目录、
# 换直链，不需要转存。分享链接转存 / 下载任务那套（状态目录 PAN115_STATE_DIR、
# 任务续跑、PAN115_SHARE_BASE）已在 v2.18.0 移除。
#
# 推荐在后台「115 账号」里保存 Cookie 配置档（支持多账号与默认账号，媒体库可单独
# 绑定账号）；下面的服务器级 Cookie 只是兼容旧部署的兜底。
# PAN115_COOKIE=UID=xxx; CID=xxx; SEID=xxx; KID=xxx
# 115 Web API 地址（域名调整或被网络策略改写时可覆盖）
# PAN115_WEBAPI_BASE=https://webapi.115.com
# PAN115_TIMEOUT=20

# ==================== 存储挂载（四种，类型由路径前缀决定）====================
# 挂载 = 把内容接进媒体库的方式，在后台「存储来源」里建，再到「媒体库管理」绑定。
# **类型由路径前缀决定**（与 backend/emby_server/mounts.py 一致）：
#   /media/...    本地硬盘（本机目录，**任何绝对路径都行**；.strm 小文件照样认）
#   115:/...      115 网盘（账号用 Cookie 配置档，目录 ID 0 = 根目录）
#   rclone:...    rclone 任意后端，形如 rclone:gdrive/Movies
#   drive:...     Google 云盘 API 直读。路径以 drive: 开头，后接共享盘 ID
#                 （个人盘写成 drive:myDrive:<rclone remote 名>）。
#                 列目录不经 rclone 挂载，实现在 mount_drive.py。
#                 这不是 v2.42.12 删掉的 Google Drive 原生类型。
#
# 远程请求超时（秒）：列目录 / 取直链 / 读 .strm 与字幕都用它
# MOUNT_TIMEOUT=20
# 远程源请求使用的 UA（部分网盘直链对 UA 有要求）
# MOUNT_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/122.0.0.0 Safari/537.36
#
# rclone：**配置完全由用户自理**。面板不代管凭据，只提供「能跑 rclone」的能力。
# - rclone.conf 在后台「rclone.conf」页粘贴（标准 INI 文本），落盘到下面这个路径，
#   调用 rclone 时自动带 --config 指过去。原文不回显（里面全是 token）。
# - rclone 可执行文件装在哪台机器上由你决定；容器里没有的话自己往镜像/compose 里加。
# MOUNT_RCLONE_CONF=data/rclone/rclone.conf
# rclone 可执行文件（不在 PATH 里时填绝对路径，如 /opt/rclone/rclone）
# MOUNT_RCLONE_BIN=rclone
# rc 服务默认地址（rc 模式：连你自己跑着的 rclone rcd --rc-serve）
# MOUNT_RCLONE_RC_URL=http://127.0.0.1:5572
# 存储读不动时，补全条目打回 pending 后等多久再试（秒；不是 failed，attempts 不涨）
# MOUNT_UNAVAILABLE_RETRY_SEC=1800
#
# rclone 内存：
# - RCLONE_RCD_GOMEMLIMIT：rcd（控制面）Go 堆上限。实测持续扫描后堆涨到 2.6GB
#   且强制 GC 只能回收约 2%（rclone 内部累积），这是安全阀不是调优——防止它吃掉
#   整机内存。默认 4GiB，内存小的机器可调小（如 2GiB）。
#   默认 4GiB，内存小的机器可调小（如 2GiB），但别小于当前水位太多以免 GC 空转。
# RCLONE_RCD_GOMEMLIMIT=4GiB
# - RCLONE_VFS_CACHE_MAX_SIZE：serve http 的 VFS 磁盘缓存上限（默认 2G）。
#   只在用 rclone serve http 取流时用得上，2G 足够。
# RCLONE_VFS_CACHE_MAX_SIZE=2G
# - RCLONE_VFS_READ_CHUNK_LIMIT：serve http 单文件内存预读上限（默认 128M）。
# RCLONE_VFS_READ_CHUNK_LIMIT=128M
#
# rclone 容器组的登录凭据（只有启用 rclone profile 才需要）：
#   docker compose --profile rclone up -d
# 下面是空值而不是写死默认口令 —— 凭据不设默认值。
# 授权版部署（docker-compose.prod.yml）用 ${RCLONE_RC_USER:-}：profile 没启用时
# 空值不阻断启动（compose 会在解析阶段展开所有 service 的变量，写成缺值就报错的话，
# 客户连默认的 4 容器都起不来）。真要用 rclone 时在这里填，容器与面板共用这一组凭据。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# 注意这里有两组名字、值必须填一致（名字对不上是真实配置坑）：
# - 面板后端只读 MOUNT_RCLONE_RC_USER / MOUNT_RCLONE_RC_PASS（mount_rclone.py）；
# - rclone 容器自己的 --rc-user/--rc-pass 由 RCLONE_RC_USER / RCLONE_RC_PASS 经
#   compose 插值传入（docker-compose.prod.yml:145-146）。
# 只填一边：要么面板连不上 rclone RC，要么 rclone 自己的鉴权没开。
MOUNT_RCLONE_RC_USER=
MOUNT_RCLONE_RC_PASS=
RCLONE_RC_USER=
RCLONE_RC_PASS=
#
# 上面两个变量在启用 rclone profile 时才需要。除此之外，编排里还有这几个与
# rclone 相关的变量（都有可用默认值，**不启用就不用管**，列在这里是为了
# 你在 compose 里看到 ${...} 时不至于一头雾水）：
# - RCLONE_CONFIG_DIR：宿主机上存放 rclone 配置的目录，默认 ./rclone。
#   后台粘贴的 rclone.conf 就落在这里（需要该目录可写）。
# - RCLONE_SA_DIR：服务账号 JSON 目录，默认 /root/sa-accounts。
#   你的 rclone.conf 里写了 ``service_account_file = /sa-accounts/x.json`` 时用它。
# - RCLONE_SERVE_REMOTE：serve http 取流的 remote 名，默认 MP。
# - RCLONE_VFS_CACHE_MIN_FREE：磁盘剩余空间低于此值就停用 VFS 缓存，默认 5G。
#   单个 4K 电影就 17G，磁盘小的机器别调太大。
# EA_INTERNAL_PORT=8002    容器内部 Emby 协议面映射到宿主机的端口，固定绑
#                          127.0.0.1（只允许本机反代访问）。**不要改**。
#
# 目录列举缓存（v2.17.0）：TTL 内同一目录只问一次远端，扫描与播放共用这份结果。
# 失败不缓存、同一目录单飞、内存有上限。设 0 可整体关掉。
# 一轮扫描进行期间不看 TTL（v2.27.0）：同一个目录在一轮扫描里会被反复问到
# （目录指纹、外挂字幕、播放侧预取），TTL 只有几秒——扫几分钟就是几十次多余的 PROPFIND。
# 2026-10 起默认 30 秒：rclone 请求风暴修复（5 秒太短，重复列举太多）。
# MOUNT_LIST_CACHE_SECONDS=30
# 最多缓存多少个目录（满了整体清空）
# MOUNT_LIST_CACHE_MAX=2000
#
# 媒体直链的内网地址（v2.23.1）：**默认允许**——局域网 NAS、rclone 的本地 HTTP 端点
# 都是正常用法（能配媒体来源的人本来就有管理权限）。
# 需要更严的部署可以打开下面这个开关（只拦「配置来源」的直链；服务器自己追出去的
# 重定向目标无论开关如何都一律拦内网 / 回环，那是能被第三方利用的 SSRF 面）。
# EMBY_BLOCK_PRIVATE_MEDIA_URLS=true
# 上面开关的放行名单（逗号分隔，按主机名，两套口径都认）：把自己的 NAS / 回环地址写进来
# EMBY_MEDIA_URL_ALLOWLIST=192.168.1.10,nas.lan,127.0.0.1

# ==================== 经济系统（v2.3.0，均可通过管理后台「经济设置」在线调整） ====================
# 注意：签到/邀请/支付/兑换的数值全部走数据库（管理后台「经济设置」在线改），
# **不是环境变量**。以前这里列过 CHECKIN_BASE_POINTS / INVITATION_REWARD_POINTS /
# PAYMENT_GATEWAY_URL 等大写键——代码里根本不读它们（r44 已删），在 env 里配了也无效。
# 要调数值请去管理后台，不要改这里。

# ==================== 反向代理与限流 IP ====================
# 只有「TCP 直连方」在这些网段里时，才采信 X-Real-IP / X-Forwarded-For / CF-Connecting-IP（防伪造）。
# 逗号分隔的 CIDR。默认只信回环 127.0.0.0/8 与内置的 Cloudflare 回源网段。
#
# Compose 部署下请求路径是「宿主机 Nginx → 宿主机端口 → docker-proxy → 容器」，
# 容器看到的直连方是 **docker 网关**，不在默认白名单 → nginx 写的 X-Real-IP 被忽略
# → 所有用户的 IP 都变成网关地址 → 共用一个限流桶（登录每分钟 10 次）→ 全站被锁。
#
# 网段务必自己查，不要照抄示例值：
#   docker network inspect aetrix-portal_default \
#     --format '{{range .IPAM.Config}}subnet={{.Subnet}} gw={{.Gateway}}{{end}}'
# 例：subnet=172.18.0.0/16 gw=172.18.0.1
# TRUSTED_PROXIES=172.18.0.0/16
#
# **跨机部署（前端/反代与后端不在同一台机器）必须额外加前端机的 IP**：
# 后端看到的直连方是前端机的公网 IP，不在名单里 → X-Real-IP 被判不可信
# 丢弃 → 全站用户在后端眼里都是前端机这一个 IP，共用一个限流桶（注册、
# 登录、验证码全被误拒 429；2026-10-22 实证：注册接口 24 小时被误拒
# 六千多次）。把前端机公网 IP 以 /32 与本机网段一起写：
# TRUSTED_PROXIES=172.18.0.0/16,203.0.113.10/32   （203.0.113.10 换成你的前端机公网 IP）
# 前置条件：前端机那一跳的 nginx 必须已经用 $remote_addr 硬写 X-Real-IP
# （仓库 docker/nginx.conf 的内层配置是透传 $http_x_real_ip，只有最外层
# 才许硬写），否则采信到的会是伪造值。改完要重启后端容器才生效；
# 验法：不同真实 IP 的请求在 Redis 里落成不同的 ratelimit:{ip}:* 键。
# 同一份信任边界也决定「没配 EMBY_PUBLIC_URL 时」播放地址肯不肯采信 X-Forwarded-Proto。
# 内置 Cloudflare 回源网段只参与真实 IP，不单凭网段让播放地址采信转发头；
# 流媒体加速或 TRUST_CF_IP 打开且已还原出真实 IP 时，这次请求的转发头仍算可信。
# FORWARDED_ALLOW_IPS 只接受精确 IP 或 CIDR。四个启动器把去掉 * 的名单显式传给 uvicorn，
# 不让它自己读到环境变量里的 *。* 很危险：伪造的客户端 IP 能绕过限流和按 IP 的访问判断。
# 含 * 时丢掉并记一次 WARNING，不能代替网段。没有其它条目时 uvicorn 只信回环。
# FORWARDED_ALLOW_IPS=172.18.0.1
# 偷懒写法（覆盖 docker 默认分配的整段私网）：TRUSTED_PROXIES=172.16.0.0/12
#
# Cloudflare 回源网段（逗号分隔 CIDR）：留空用内置列表；Cloudflare 公布新网段时可在这里整体覆盖
# CLOUDFLARE_IP_RANGES=173.245.48.0/20,103.21.244.0/22,2400:cb00::/32

# ==================== 稳定性调优（均为可选，留空即用默认值） ====================
# --- Redis 故障降级（运行期 Redis 宕机 / 网络分区时不拖垮全站）---
# 单次 Redis 读写 / 连接超时（秒），默认 1（旧版 5 秒且超时重试）
# REDIS_SOCKET_TIMEOUT=1
# REDIS_CONNECT_TIMEOUT=1
# 连续失败多少次熔断，默认 3；熔断后多少秒内改用内存缓存 / 进程内限流（之后自动探测恢复），默认 30。
# 启动时没连上 Redis 也会按这个间隔在后台重连
# REDIS_BREAKER_FAILURES=3
# REDIS_BREAKER_SECONDS=30
# --- 合并容器（run_all）里 worker 的重启策略：worker 退出永远不会拉停 API / EA ---
# 首次重启等待（秒），之后每次翻倍，默认 5；上限默认 300
# WORKER_RESTART_BASE=5
# WORKER_RESTART_MAX=300
# worker 连续稳定运行超过这么多秒后退避计数清零，默认 600
# WORKER_STABLE_SECONDS=600
# worker 启动时 Redis 不可用会等待重连（不退出），重试间隔上限（秒），默认 30
# WORKER_REDIS_WAIT_MAX=30
# --- /Items 去重（SQL 下推）：可能重复 / 被去掉的行超过这些数量时回退到旧的全量去重 ---
# ITEMS_DEDUP_MAX_SUSPECTS=20000
# ITEMS_DEDUP_MAX_DROPPED=5000

# ==================== Cloudflare 边缘缓存（通用能力，可选） ====================
# 把视频分片缓存在 CF 边缘，热门内容首字节从"回源悉尼"变成"边缘命中"。
# 三档（默认 off = 今天行为逐字节不变）：
#   off          只走 CF 代理，不声明缓存（默认）
#   query_ignore 声明"我已在 CF 配了忽略查询串的 Cache Rule"；
#                服务端零行为变更，只在 /stream 响应多带
#                X-Edge-Cache-Mode: query-ignore 调试头，方便验证 CF 是否命中。
#                全客户端兼容（SenPlayer/Infuse/Emby 官方无感知）。
#   header       预留（Phase 2，另立项），本期等同 off
# 配好后按 docs/edge-cache.md 在 CF 后台加 1 条 Cache Rule（免费版可用）。
# ⚠️ 安全：query_ignore 下共享 URL 在缓存 TTL 内可被未授权访问（对比现状：
# 签名 URL 本来就有 15 分钟～6 小时窗口）。默认 off，知情后才开；高敏感站点别开。
# 降级：CF 没配好 = MISS 回源走完整鉴权，不坏；改回 off 即刻生效（热读，无需重启）。
# EDGE_CACHE_MODE=off

# ==================== 媒体信息探测 worker（v2.53 重构）====================
# 单体（python serve.py）与 worker 角色都会启动；api 角色不启动。全部可选，默认值适合远程挂载。
# PROBE_ONDEMAND_ENABLED=1          # 总开关
# PROBE_ITEM_TYPES=movie,episode    # 需要探测的类型（只探电影：movie）
# PROBE_WORKERS=4                   # 总并发
# PROBE_REMOTE_CONCURRENCY=2        # 每个远程挂载（115/rclone/WebDAV/FUSE/直链）并发
# PROBE_LOCAL_CONCURRENCY=4         # 每个本机磁盘挂载并发
# PROBE_MIN_INTERVAL_SEC=0.5        # 两次探测启动的最小间隔（全局，保护网盘配额）
# PROBE_ITEM_TIMEOUT_SEC=60         # 单条目探测总预算（所有 ffprobe/mediainfo 子进程共享，超时整组杀）
# PROBE_RESOLVE_TIMEOUT_SEC=20      # 单条目解析地址上限（挂载 API / FUSE stat）
# PROBE_CLAIM_TTL_SEC=900           # probing 租约：超过即视为 worker 已死，自动放回 pending
# PROBE_BREAKER_THRESHOLD=3         # 同一挂载连续超时几次熔断
# PROBE_BREAKER_COOLDOWN_SEC=300    # 熔断冷却（每次翻倍，最长 1 小时）
# PROBE_MAX_ATTEMPTS=3              # 单条最多尝试次数，超过标 failed（后台可一键重置）
# PROBE_RETRY_BASE_SEC=60           # 退避基数：60/120/240…
# PROBE_RETRY_MAX_SEC=21600         # 退避上限
# PROBE_TRIAGE_INTERVAL_SEC=21600      # 队列整理（triage）间隔：启动先跑一轮，之后按此间隔重复
# PROBE_HEADTAIL_ENABLED=1          # 头尾探测总开关（正案第1步）：头尾两次读+稀疏文件+ffprobe，关掉回退旧三跳
# PROBE_HEADTAIL_HEAD_BYTES=4194304 # 头部窗口（默认4MiB）
# PROBE_HEADTAIL_TAIL_BYTES=16777216 # 尾部窗口（默认16MiB）
# PROBE_HEADTAIL_PROBESIZE=5242880  # 头尾探测的 ffprobe -probesize（默认5M）
# PROBE_HEADTAIL_ANALYZEDURATION=0  # 头尾探测的 ffprobe -analyzeduration（默认0）

# ==================== 后台调参与高级开关（r44 补齐：不懂别动） ====================
# 以下键全部在代码里真实读取（r44 逐键亲验读取点与默认值），但日常部署用不到，
# 全部留空 = 代码默认值。**不确定就别动**：调错最多影响后台效率/告警灵敏度，
# 不影响起服务；但调得太激进（如轮询间隔过小）可能触发上游限流。
#
# ---- 系统告警（阈值；告警开关本身在管理后台「系统告警」，SYSTEM_ALERTS_ENABLED 只是总闸）----
# 系统告警总闸：未设=关；DB 配置 system_alerts_enabled 也可开，任一开即开
#SYSTEM_ALERTS_ENABLED=1
# 告警轮询间隔（秒），默认 600；优先级：DB 配置 > 环境变量 > 默认；钳制 60~86400
#ALERT_CHECK_INTERVAL_SEC=600
# API 错误率超此比例触发告警（默认 0.05=5%）；仅默认规则播种种子，之后以 DB 规则为准
#ALERT_API_ERROR_RATIO=0.05
# 磁盘可用空间低于此百分比触发"磁盘空间不足"严重告警（默认 10.0）
#ALERT_DISK_FREE_PCT=10.0
# enrich 积压低于此条数时"补全停滞"告警不触发（默认 1000，防小积压误报）
#ALERT_ENRICH_BACKLOG_FLOOR=1000
# enrich 工人闲置超此秒数且积压超下限，触发"补全停滞"告警（默认 7200=2小时）
#ALERT_ENRICH_IDLE_SEC=7200
# 探测队列长度超此条数触发"探测队列堆积"告警（默认 5000）
#ALERT_PROBE_QUEUE_HIGH=5000
#
# ---- 可观测性（默认全关，开了才采集详细指标）----
# 可观测性总开关：默认 0=关；开后聚合接口才返回指标、中间件才记录
#OBSERVABILITY_ENABLED=0
# API P99 延迟超此毫秒数标 warn（默认 2000.0；只做展示分级）
#OBS_API_P99_MS_WARN=2000.0
# API 错误率超此比例标 warn（默认 0.05）
#OBS_API_ERROR_RATIO_WARN=0.05
# 磁盘余量低于此百分比标 warn（默认 15.0）
#OBS_DISK_FREE_WARN=15.0
# enrich 积压超此条数标 warn（默认 500；health 的 down 线另算）
#OBS_ENRICH_BACKLOG_WARN=500
# probe 队列堆积超此条数标 warn（默认 1000）
#OBS_PROBE_QUEUE_WARN=1000
# /metrics 允许公网访问：默认空=不允许（只放行本机/内网，其他来源 403 并写告警日志）
#METRICS_ALLOW_REMOTE=true
#
# ---- 一键诊断（判定阈值，默认即可；管理后台一键诊断的结论口径用）----
# 以下键在 backend/diagnosis.py THRESHOLD_DEFS / backend/diagnosis_fix.py
# FIX_THRESHOLD_DEFS 元组里定义，经 get_threshold / get_fix_threshold 以变量传键
# 读 _env_float：环境变量 > 默认值；非法值回落默认值（无钳制）
# 磁盘余量低于此百分比判"注意"（默认 15.0）
#DIAG_DISK_WARN_PCT=15.0
# 磁盘余量低于此百分比判"严重"（默认 10.0）
#DIAG_DISK_CRIT_PCT=10.0
# 探测待办超过此条数判"注意"（默认 5000）
#DIAG_PROBE_QUEUE_WARN=5000
# enrich 积压少于此条数时不判"补全停滞"（默认 1000，防小积压误判）
#DIAG_ENRICH_BACKLOG_FLOOR=1000
# enrich 积压且超过此秒数无产出判"补全停滞"（默认 7200=2小时）
#DIAG_ENRICH_IDLE_SEC=7200
# API 错误率超过此比例判"注意"（默认 0.05=5%）
#DIAG_API_ERROR_RATIO=0.05
# 自动修复时探测认领租约 TTL（秒，默认 -1.0；<= 0 时用 probe_worker 模块默认值）
#DIAG_FIX_PROBE_TTL_SEC=-1.0
# 自动修复淘汰过期字幕缓存（默认 1=淘汰；=0 不做字幕缓存淘汰）
#DIAG_FIX_SUBTITLE_CACHE=1.0
#
# ---- enrich 刮削（元数据补全后台）----
# enrich 别名索引内存条目上限（默认 50000，下限 1000；防内存膨胀）
#ENRICH_ALIAS_INDEX_MAX=50000
# enrich 别名索引条目 TTL（秒，默认 300，下限 30；过期自动失效重建）
#ENRICH_ALIAS_INDEX_TTL=300
# 补全 worker 总开关（默认 1=开；=0 禁用；健康报告此时不报"没在跑"）
#ENRICH_WORKER=1
# 补全 worker 线程数（默认 8，IO 密集型；手动值钳制 1~16；改完需重启 worker；
# 环境变量专供，管理后台不可改）
#ENRICH_WORKERS=8
# 补全 worker 每批认领条数（默认 200，下限 10；环境变量专供，管理后台不可改）
#ENRICH_BATCH=200
# 认领租约（秒，默认 900，下限 60；worker 停滞超过租约即视为死亡，由 janitor 回收抢单）
#ENRICH_CLAIM_LEASE_SEC=900
# 补全 worker 空闲时轮询等待间隔（秒，默认 30，下限 5）
#ENRICH_IDLE_POLL_SEC=30
# janitor 维护循环间隔（秒，默认 60，下限 10；回收死亡认领、none 回捞等）
#ENRICH_JANITOR_INTERVAL_SEC=60
# 认领时媒体库公平调度（默认 1=开；老分类不被新入库条目饿死；=0 关闭）
#ENRICH_LIBRARY_FAIRNESS=1
# 异常失败重试上限次数（默认 5，下限 1）
#ENRICH_MAX_ATTEMPTS=5
# 重试退避基数（秒，默认 60，下限 10；按 60s×2ⁿ 指数退避）
#ENRICH_RETRY_BASE_SEC=60
# TMDB 批量开关（默认 1=开；1=批量调 batch_search/batch_details，0=逐条原逻辑）
#ENRICH_TMDB_BATCH=1
# TMDB 请求速率上限（次/秒，默认 2.0，下限 1.0；429 自适应降速后最多恢复到此值）
#ENRICH_TMDB_PER_SEC=2.0
# TMDB 429 自适应降速的速率下限（次/秒，默认 1.0，下限 1.0）
#ENRICH_TMDB_MIN_PER_SEC=1.0
# TMDB 文字字段只填空缺不覆盖（默认空/1=只填空；显式 0 回滚为旧覆盖行为；未设读管理后台配置）
#ENRICH_TMDB_TEXT_FILL_ONLY=1
# 单集夜间刮削：=1 时白天只刮顶层条目（movie/series/season），单集只在夜间窗口内刮（默认开；未设读管理后台/数据库，存量行优先）
#ENRICH_EPISODE_NIGHT_ONLY=1
# 单集夜间窗口开始时刻（默认 02:00；HH:MM；支持跨午夜；未设读管理后台配置）
#ENRICH_NIGHT_START=02:00
# 单集夜间窗口结束时刻（默认 06:00；HH:MM；支持跨午夜；未设读管理后台配置）
#ENRICH_NIGHT_END=06:00
# 夜间窗口解释时区（默认 Asia/Shanghai；IANA 时区名，不再用服务器本地时间；未设读管理后台配置）
#ENRICH_NIGHT_TZ=Asia/Shanghai
# 单集下沉时是否写入标题/简介/剧照（默认全开；未设读管理后台配置；分项开关只管"写什么"，不管"何时抢单"）
#ENRICH_EPISODE_TITLE=1
#ENRICH_EPISODE_OVERVIEW=1
#ENRICH_EPISODE_STILL=1
# 单集多版本功能开关（默认 1=开；=0 时管理接口返回 400 拒绝）
#EPISODE_VERSIONS_ENABLED=1
# 单次批量"翻转"（条目大面积被翻回 pending）告警阈值（条数，默认 100，范围 1~1000000；达到该条数发告警）
#ENRICH_FLIP_ALERT_THRESHOLD=100
# 被扫描抢占时 enrich 每次等待秒数（默认 5，下限 1；另加 0~2 秒随机抖动）
#ENRICH_PREEMPT_WAIT_SEC=5
# 有扫描等待、被抢占时 enrich 保留的最少线程数（默认 4，下限 1）
#ENRICH_PREEMPT_MIN_THREADS=4
# 抢占让路熔断器：连续让路超此分钟数自动恢复（默认 30，下限 1）
#ENRICH_PREEMPT_MAX_YIELD_MIN=30
# 熔断器：扫描队列长度此分钟数无变化则自动恢复（默认 10，下限 1）
#ENRICH_PREEMPT_QUEUE_STALL_MIN=10
#
# ---- probe 媒体探测（v2.53 重构后的 worker）----
# 每轮从队列抢单的最大条数（默认 20，范围 1~200）
#PROBE_CLAIM_BATCH=20
# 独占模式冷却：并发为 1 时每次探测后休眠 N 秒（默认 0.0=不休眠）
#PROBE_COOLDOWN_SEC=0.0
# 扫描期本地文件头探测超时（秒，默认 30.0，下限 5.0；读不出的文件不等满 90 秒，避免白占 worker 槽位）
#PROBE_FILE_TIMEOUT_SEC=30.0
# 空队列指数退避上限（秒，默认 300.0，下限 1.0；连续空轮翻倍睡眠最高到此值）
#PROBE_IDLE_MAX_SLEEP_SEC=300.0
# 空队列基础睡眠秒数（默认 5.0，下限 0.2；退避起点）
#PROBE_IDLE_SLEEP_SEC=5.0
# 播放状态检测结果缓存秒数（默认 30.0，下限 1.0；避免每轮调度都查库）
#PROBE_PLAYBACK_CHECK_SEC=30.0
# 有播放时 probe 并发降到的上限（默认 1，范围 1~16；后台探测不抢播放链路资源）
#PROBE_PLAYBACK_WORKERS=1
# 连续提交不等待的个数（默认=PROBE_WORKERS，范围 1~200；解除"每提交必等 0.5s"硬上限）
#PROBE_SUBMIT_BURST=20
# probe 队列整理（triage）每批处理条数（默认 5000，范围 100~100000）
#PROBE_TRIAGE_CHUNK=5000
# 远程探测第一跳 Range 窗口（字节，默认 1048576=1MiB，下限 256KiB；实测 1MiB 稳定拿到 mkv 时长，8MiB 会触发截断失败）
#PROBE_REMOTE_RANGE_BYTES=1048576
# 远程探测第二跳尾部窗口（字节，默认 2097152=2MiB；仅对 moov 可能在文件尾的 MP4/MOV 系容器并行取尾巴找时长）
#PROBE_REMOTE_TAIL_BYTES=2097152
# 自适应尾窗上限（字节，默认 8388608=8MiB，下限 1MiB；moov 大于尾部窗口时按 mdat 声明长度算出起点、
# 在此上限内补一次精确 Range 取齐 moov，超过上限的保持现行失败语义；实测生产大文件 moov 2.2~4.6MiB）
#PROBE_MOOV_MAX_BYTES=8388608
# 远程 URL 的 ffprobe 探测上限（秒，默认 90.0，下限 10.0；网络慢是常态，砍时间会误伤真大文件）
#PROBE_REMOTE_TIMEOUT_SEC=90.0
# 远程探测第三跳（整文件拉取）流量闸（字节，默认 1073741824=1GiB；已知大小超阈值跳过整文件兜底、记 degraded；<=0 表示不设闸）
#PROBE_WHOLE_FILE_MAX_BYTES=1073741824
#
# ---- 扫描 ----
# 文件指纹秒跳总开关（默认 1=开；关则增量扫描不再秒跳已见指纹的文件）
#SCAN_FAST_SKIP=1
# 强制远程模式（默认 0=关；FUSE 挂载有本地路径但 IO 慢时，设 1 则所有文件按远程处理、跳过逐文件 FUSE 慢操作）
#SCAN_FORCE_REMOTE=0
# 两阶段扫描（默认 1=开；Phase 1 只做秒级极简入库，side/NFO/TMDB 交 enrich 后台补全）
#SCAN_LAYERED=1
# 扫描探测模式：inline=扫描时直接 ffprobe（旧行为）；background=Phase 1 不探测，probe_worker 后台按优先级探测
#SCAN_PROBE_MODE=inline
# 删除保护：单轮最多删多少条目（绝对数，默认 20，范围 1~1000000；超限则停手不删，防挂载断开误清整库）
#SCAN_REMOVAL_MAX_ABSOLUTE=20
# 删除保护：单轮删除超库内文件条目此比例就停手（默认 0.5=一半以上没了；最小 0.0）
#SCAN_REMOVAL_MAX_RATIO=0.5
# 缺失宽限：单个文件连续缺失多少轮扫描才真正下架（默认 3，范围 1~1000；1=确认缺失即下架的旧行为）。防挂载抖动/目录半读把单条误删，文件回来自动清零
#SCAN_MISSING_GRACE_SCANS=3
# 扫描标志挂 True 超此小时数视为崩溃残留，由维护任务清理（默认 6）
#SCAN_STALE_HOURS=6
# 前台让路总开关（默认 1=开；置 0 整局关闭前台让路，回旧行为：重活不让出 CPU）
#SCAN_FOREGROUND_YIELD=1
# 前台让路每轮睡眠秒数（默认 5.0；前台=用户在用网页，活跃时扫描小睡此秒数再继续）
#SCAN_FOREGROUND_SLEEP_S=5.0
# 前台活跃判定窗口（秒，默认 120.0；120 秒内有 redis 活跃即视为有人在用）
#SCAN_FOREGROUND_WINDOW_S=120.0
# 前台活跃时扫描单次让路的绝对上限（秒，默认 900.0；实际让路还受下面的配额约束，取更小者）
#SCAN_FOREGROUND_MAX_YIELD_S=900.0
# 让路配额：先连续干满多少秒才许让一次（默认 60.0；没干满时哪怕前台有人也不让，防「干一点睡一轮」）
#SCAN_FOREGROUND_WORK_MIN_S=60.0
# 让路配额：单次让路 ≤ 已干时长 × 此比例（默认 0.25；干 60 秒最多让 15 秒，保证后台活至少约八成时间在干活）
#SCAN_FOREGROUND_YIELD_RATIO=0.25
# 有扫描排队/运行时是否抢占 enrich 线程给扫描让路（默认 1=开）
#SCAN_PREEMPT_ENRICH=1
# 宽松归一化追加虚词字符集（默认空；内置"的之和与特·-＆&・･•"，影响同剧识别/扫描防重合并）
#SERIES_LOOSE_PARTICLES=
#
# ---- 缩略图 ----
# 缩略图提取后台总开关（默认 1=开）
#THUMBNAIL_EXTRACT_ENABLED=1
# 缩略图提取后台轮次间隔（秒，默认 21600.0=6h，最小 3600）
#THUMBNAIL_INTERVAL_SEC=21600.0
# 每个视频提取几张缩略图（默认 10，范围 1~50）
#THUMBNAIL_COUNT=10
# 缩略图提取每轮最多认领多少条目（默认 500，范围 10~10000）
#THUMBNAIL_BATCH_LIMIT=500
# 缩略图文件落盘目录（默认 /data/thumbnails）
#THUMBNAIL_ROOT=/data/thumbnails
# 单次 ffmpeg 提取调用超时（秒，默认 60，范围 10~600）
#THUMBNAIL_FFMPEG_TIMEOUT=60
# 单个视频的缩略图提取总预算（秒，默认 300，范围 60~1800；防远程大文件拖死）
#THUMBNAIL_PER_VIDEO_TIMEOUT=300
#
# ---- 字幕 ----
# 字幕扫描后台总开关（默认 1=开）
#SUBTITLE_SCAN_ENABLED=1
# 字幕扫描后台轮次间隔（秒，默认 43200.0=12h，最小 3600）
#SUBTITLE_SCAN_INTERVAL_SEC=43200.0
# 字幕扫描每轮最多认领多少条目（默认 10000，范围 100~100000）
#SUBTITLE_SCAN_BATCH_LIMIT=10000
# 字幕缓存目录（默认 <EMBY_CACHE_DIR>/subs；EMBY_CACHE_DIR 未设时回落 /tmp/aetrix_cache/subs）
#EMBY_SUBTITLE_DIR=
# 字幕缓存文件数上限（默认 2000；超了按最旧先删）
#SUB_CACHE_MAX_FILES=2000
# 字幕缓存最长保留天数（默认 7；超了按最旧先删）
#SUB_CACHE_MAX_DAYS=7
#
# ---- 人物补全 ----
# 人物全量巡检（去重）间隔（秒，默认 86400=24h）
#PERSON_REFRESH_INTERVAL_SEC=86400
# 人物补头像后台轮次间隔（秒，默认 1800=30分钟）
#PERSON_FILL_INTERVAL_SEC=1800
# 人物补头像单轮最多处理的行数（默认 50）
#PERSON_FILL_BATCH=50
# 人物补全每轮走豆瓣兜底的最多条目数（默认 10；每条目 1~2 次请求）
#PERSON_DOUBAN_ITEMS_PER_RUN=10
# 同一行/条目补头像失败后多久再试（秒，默认 86400=1天；进程内记忆防反复打同一批）
#PERSON_FILL_RETRY_SEC=86400
#
# ---- 同剧/多版本合并 ----
# 多版本合并后台总开关（默认 1=开；关则后台线程不启动）
#MERGE_VERSIONS_ENABLED=1
# 多版本合并后台轮次间隔（秒，默认 86400.0=24h，下限 3600.0；合并是低频操作）
#MERGE_VERSIONS_INTERVAL_SEC=86400.0
# 单轮多版本合并最多处理的重复组数上限（默认 1000，范围 10~100000）
#MERGE_VERSIONS_BATCH_LIMIT=1000
#
# ---- TMDB ----
# 覆盖 TMDB API 基址（默认空=走 DB 配置/默认 https://api.themoviedb.org/3；可配代理/镜像）
#TMDB_API_BASE=
# 覆盖 TMDB 图片基址（默认空=走 DB 配置/默认 https://image.tmdb.org/t/p）
#TMDB_IMAGE_BASE=
# TMDB HTTP 请求超时（秒，默认 10.0，最小 5.0）
#TMDB_TIMEOUT=10.0
# TMDB 网络请求重试次数（默认 2，钳制 0~4）
#TMDB_NET_RETRIES=2
# 尊重上游 Retry-After 头的最大上限（秒，默认 20.0，最小 1.0；防上游让等离谱时长）
#TMDB_RETRY_AFTER_CAP_SEC=20.0
# TMDB 故障后恢复探针的等待基准（秒，默认 50，最小 5）
#TMDB_RECOVER_AFTER=50
# TMDB key 触发 429 限流后的冷却时长（秒，默认 900=15分钟；429 恢复探针用）
#TMDB_KEY_COOLDOWN_SEC=900
# TMDB key 报 401（key 废了）后的冷却时长（秒，默认 21600=6h；等管理员换 key）
#TMDB_KEY_INVALID_COOLDOWN_SEC=21600
# TMDB 语言 fallback 最大深度（默认 2，钳制 0~5；首选语言+最多 N 种备选；0=关闭 fallback）
#TMDB_FALLBACK_MAX_LANGS=2
# TMDB 磁盘缓存总开关（默认 1=开；设 0 关闭，关后只走真实 HTTP，便于测真实请求量）
#EMBY_TMDB_CACHE=1
# TMDB 磁盘缓存目录（默认 <EMBY_CACHE_DIR>/tmdb）
#EMBY_TMDB_CACHE_DIR=
# TMDB 磁盘缓存容量上限 MB（默认 256；0=不限；巡检时超限按最旧优先清理）
#EMBY_TMDB_CACHE_MB=256
# TMDB 搜索命中缓存 TTL（秒，默认 604800=7天，下限 60）
#EMBY_TMDB_TTL_SEARCH=604800
# TMDB 详情接口缓存 TTL（秒，默认 2592000=30天，下限 60；调大省 API 调用、调小数据更新）
#EMBY_TMDB_TTL_DETAILS=2592000
# TMDB 搜索"无结果"（阴性）缓存 TTL（秒，默认 86400=24h，下限 60；防同一搜不到的关键词反复打 API）
#EMBY_TMDB_TTL_NEGATIVE=86400
# TMDB 缓存里原始响应（raw 双份快照）单条上限 KB（默认 64；超限只存截断标记+开头节选；0=不存原始响应）
#EMBY_TMDB_CACHE_RAW_MAX_KB=64
#
# ---- 元数据 provider 熔断（FMBY 学习批一 #8；TMDB/豆瓣/Bangumi/OMDb/TheTVDB/AniList/TVMaze 每源独立）----
# provider 熔断总开关（默认 1=开；设 0 关闭，关后所有源照常发请求、只记账不开断）
#PROVIDER_BREAKER_ENABLED=1
# 连续失败几次打开熔断（默认 3；打开后该源在冷却期内不再发请求，自动采集直接跳过）
#PROVIDER_BREAKER_THRESHOLD=3
# 熔断冷却时长（秒，默认 60；到期放行一个探测请求，成功自动恢复、失败重新冷却）
#PROVIDER_BREAKER_COOLDOWN_SEC=60
# 403/429（源明确拒绝/限流）快速熔断时长（秒，默认 60；这类错误不等凑满连续失败次数、一次就开断）
#PROVIDER_BREAKER_FAST_SEC=60
# 图片预热下载失败重试次数（默认 2，总尝试 1+2=3 次；0.5s 起指数退避加抖动）
#EMBY_IMAGE_RETRIES=2
# 仪表盘重聚合快照（trend/detail 两路）后台刷新周期/新鲜期（秒，默认 120，范围 10~3600；期内读路径只读快照）
#DASHBOARD_SNAPSHOT_REFRESH_SEC=120
# 仪表盘快照最大陈旧（秒，默认 900，范围 60~86400；陈旧未过此值先用旧快照+后台刷新，超过或缺失时同步算一次兜底）
#DASHBOARD_SNAPSHOT_MAX_STALE_SEC=900
#
# ---- 维护清理（janitor，每 600 秒一轮）----
# 维护轮次间隔（秒，默认 600，下限 60；r43 起 EA 进程跑轻量模式）
#MAINTENANCE_INTERVAL=600
# 播放会话心跳超此分钟未更新视为已结束（默认 10）
#SESSION_STALE_MINUTES=10
# 播放会话历史保留天数（默认 0=永久保留；设如 90 则自动裁掉更早记录，后台播放统计只剩保留期内）
#SESSION_RETENTION_DAYS=0
# Emby token 最后使用时间写库节流间隔（秒，默认 60；0=每次请求都写库；节流降 DB 写入压力）
#EMBY_TOKEN_TOUCH_SECONDS=60
# 任务调度器总开关（默认 1=开；含扫描抢占 enrich 逻辑）
#TASK_SCHEDULER_ENABLED=1
#
# ---- Drive 增量（Changes API 轮询）----
# Drive Changes 增量轮询总开关（默认 1=开；关闭后轮询线程直接退出并记日志）
#DRIVE_CHANGES_ENABLED=1
# Drive Changes 轮询间隔（秒，默认 300，下限 60）
#DRIVE_CHANGES_INTERVAL=300
# 轮询间隔随机抖动比例（默认 0.2，钳制 0~0.5；防多账号请求完全规律被 Google 识别为机器刷，反风控）
#DRIVE_CHANGES_JITTER_RATIO=0.2
# Drive Changes 判定驱动器"死亡"后的重试间隔（秒，默认 86400=24h，下限 3600；404 是永久性配置问题，退避期内直接跳过该盘）
#DRIVE_CHANGES_DEAD_RETRY_SEC=86400
# SA 根目录（默认 /sa-accounts；下面有 sa/*.json；Drive 增量发现与流节点收集 SA 凭据的第一兜底路径）
#RCLONE_SA_DIR=/sa-accounts
#
# ---- Drive 链接分享自动补开（2026-10-19 播放事故治本）----
# 新文件入库后异步给其 Drive 文件创建 anyone reader 权限（默认 1=开）。
# 播放是 302 到 usercontent 匿名直链，没有该权限会被谷歌登录页拦截、播不了。
# 失败不影响入库，enrich janitor 巡检（约 2 小时一轮、单轮 150 文件）兜底。
#DRIVE_SHARE_AUTO_ENABLED=1
#
# ---- 播放链路 ----
# PlaybackInfo 媒体源缓存秒数（默认 300；>0 才缓存，key 含 user_id+设备指纹+码率上限，不含对外基址；设 0 关闭缓存）
# 缓存体是 MediaSource，字幕 DeliveryUrl 里的基址会留到 TTL 结束。
# DirectStreamUrl / DirectPlayUrl / TranscodingUrl 在读缓存之后按当次基址重拼。
#PLAYBACKINFO_CACHE_TTL=300
# 播放进度写库节流间隔（秒，默认 15；15 秒内重复上报不重复写库；0=回到每报必写旧行为）
#EMBY_PROGRESS_WRITE_SECONDS=15
# 播放进度上报中"快进/快退"判定的跳跃幅度阈值（ticks，默认 300000000≈30 秒；1 秒=1000 万 ticks）
#EMBY_PROGRESS_SEEK_TICKS=300000000
# 播放链路 Drive 文件存在性检查的并发线程上限（默认 16；非法值记 warning 后回落 16）
#DRIVE_EXISTS_CHECK_WORKERS=16
# 播放链路 Drive 文件存在性检查的正缓存 TTL（秒，默认 600；0 或负数=关闭，每次播放都真实 files.get；404/异常不缓存）
# 非法值只在进程启动时记一次 warning 并回落默认 600。改这项需重启。
#DRIVE_EXISTS_CACHE_TTL_SEC=600
# 播放解析结果缓存 TTL（秒，默认 600；0=关闭，每次播放都重新向网盘解析直链）。
# 解析结果（直链+静态头）按挂载+路径缓存，省掉重复播放的逐级列目录/换链往返；
# 凭据头（Cookie/Bearer）不进缓存、命中后现挂。非法值记 warning 后回落默认 600，
# 取值钳制在 0–3600。启动时读一次，改这项需重启。调参只走 env，不进管理后台。
#RESOLVE_TARGET_CACHE_TTL_SEC=600
# 播放路数租约存活秒数（默认 600，钳制 30–3600）。「按挂载+路径前缀限同时播放
# 路数」（策略存 system_configs 的 stream_path_limits 键，JSON 数组）的计数是
# 租约式的：起播占位、播放中刷新、停播后最多多占一个 TTL 才自动释放。
#STREAM_LIMIT_LEASE_TTL_SEC=600
# 身份准入货架总开关（1=开，默认 0=关）：开启后用户端货架面（浏览/列表/
# 计数/推荐/最新）只露出已绑定 TMDB/IMDb 身份的条目（集跟随所属剧的绑定，
# 只有豆瓣身份不算）；搜索面不收紧、凭 guid/编号直达不受影响，管理端
# 照常看见全部条目。判据唯一实现在 backend/emby_server/identity_gate.py。
# 切换开关必须同时全库 bump 数据版本清列表缓存（缓存键不含开关状态，
# 只改本项不清缓存不生效）。启动时读一次，改这项需重启。
#IDENTITY_SHELF_GATE=0
# 同一客户端对同一文件、相同 Range 起始字节的复验窗口（秒，默认 15；0 或负数=关闭）。
# 窗口内再次请求视为播放器在谷歌 404 后的重试，跳过正缓存重新 files.get。
# 起始字节变了（拖动 / 下一段）不算重试。开播时 300ms 内连发的 bytes=0- 也不算重试。
# 非法值只在进程启动时记一次 warning 并回落默认 15。调参只走 env，不进管理后台。
#DRIVE_EXISTS_RETRY_WINDOW_SEC=15
# 播放链路耗时日志总开关（默认 1=开；import 时读一次，热路径零开销；关时计时器直接返回 no-op 单例）
#PLAY_TIMING_LOG=1
# 起播事件打点总开关（默认 1=开；import 时读一次）。每次起播在调度层记一条事件
# （源/分发方式/解析耗时/成败与错误类型）落 emby_play_start_events 表供管理端聚合；
# 落库走进程内队列 + 后台批量写，队列满或写失败静默丢弃，绝不阻塞起播。改这项需重启。
#PLAY_START_EVENTS_ENABLED=1
# Emby 筛选项（filters）缓存 TTL（秒，默认 300；调小更实时、调大更省计算）
#EMBY_FILTERS_CACHE_TTL=300
# filters 缓存重建最小间隔（秒，默认 5；防缓存过期瞬间并发请求同时重算击穿）
#EMBY_FILTERS_MIN_REFRESH=5
# 客户端协议响应里不下发服务器真实媒体路径（默认 1=开；防 MediaSources[].Path 被三方客户端显示泄露目录结构；不影响播放）
#EMBY_HIDE_MEDIA_PATH=1
# 强制 Rex/VidHub 播放器一键导入深链里的 scheme（默认空=跟随 URL 自带 scheme，缺省 http；反代/HTTPS 环境下用它钉住 https，避免生成 http 导入链）
#EMBY_URL_SCHEME=
#
# ---- 安全/域名 ----
# 未设 SECRET_KEY 时允许服务启动、改用临时随机 JWT 密钥（默认空=关；1/true/yes/on 为真；重启后所有 token 失效；仅一次性本地测试，生产禁止）
#ALLOW_EPHEMERAL_SECRET=
# 域名强制守卫（默认空=不限制；逗号分隔；DB 里配了 stream_accel_domain 则以 DB 为准；非名单域名的请求被拦截）
#ENFORCE_DOMAIN=
# DNS pinning 总开关（默认 true=开；1/true/yes/on 为开；防 DNS 劫持/重绑定；关闭后回退到正常 DNS）
#EMBY_DNS_PINNING=true
# 信任 Cloudflare 回源 IP 做客户端真实 IP 提取（默认空=不信任；1/true/yes/on 任一；另有 DB 加速配置可并行开启）
#TRUST_CF_IP=
# 首次建管理员向导的一次性 token（默认空；POST 必须携带一致才允许建首个管理员；空=旧行为但打 warning；成功建完后入口永久关闭）
#SETUP_BOOTSTRAP_TOKEN=
#
# ---- 出站代理 ----
# 后端出站请求（TMDB/115/网盘/AI 等）统一走的代理 URL（默认空；**由管理后台「网络代理」能力保存后自动写入进程环境变量，一般不用手动配**；httpx/requests/rclone 自动识别）
#ALL_PROXY=
# 不走出站代理的地址名单（默认 localhost,127.0.0.1；逗号分隔；由管理后台代理配置 proxy_no_proxy 落地；内网域名、Emby 上游、NAS 等写这里）
#NO_PROXY=localhost,127.0.0.1
# 115 网盘 API 请求使用的 User-Agent（默认 Chrome 122 UA；115 直链接口对 UA 有偏好）
#PAN115_USER_AGENT=
#
# ---- 存储/备份 ----
# PostgreSQL 备份（pg_dump custom+gzip）落盘目录（默认 /var/backups/aetrix；不可写则备份抛错）
#PG_BACKUP_DIR=/var/backups/aetrix
# 封面生成任务最小执行间隔（秒，默认 2，下限 0；间隔内重复请求会等待，防频繁重复生成打满 CPU）
#COVER_MIN_INTERVAL_SEC=2
# change_watcher 用 find 命令扫描新增文件的超时上限（秒，默认 60，下限 10；调大可容忍慢目录，调小 fail-fast）
#CHASE_NEW_FIND_TIMEOUT=60
#
# ---- 面板/API ----
# 进程角色（默认空；api/worker/all/stream：api 模式扫描任务入 Redis 队列、worker 模式消费、all 单体模式；reachability 据此判断 EA 是否同容器可读本机路径）
#AETRIX_ROLE=
# 面板 v4 接口特性开关（默认 1=开；关则全部 v4 接口返回 403 disabled）
#PANEL_V4_ENABLED=1
# 管理 API Key 允许的 scope 名单（默认 read,write,admin；逗号列表，顺序即层级，靠后包含靠前；每次调用热读环境变量，改配置不重启生效）
#API_KEY_SCOPES=read,write,admin
# 管理 API Key 创建/修改时允许的最大有效期上限（天，默认 3650≈10 年）
#API_KEY_MAX_EXPIRE_DAYS=3650
# API Key 哈希加盐（默认空；显式配置优先，否则自动由 SECRET_KEY 经 HMAC-SHA256 单向派生）
#API_KEY_PEPPER=
# 中文标题按拼音首字母 A-Z 排序（默认 1=开；关则回退 name.lower()）
#PINYIN_SORT_ENABLED=1
# SQLAlchemy echo 开关（默认 false；开后每条 SQL 打日志，用于排查 SQL 问题）
#DB_ECHO=false
# rclone FUSE 挂载点前缀名单（默认 /mnt/mp/,/mnt/paul/；逗号分隔；这些路径的读走 FUSE 抖动容忍逻辑：OSError 重试线性退避，防 Drive 配额/网络抖动中途失败）
#EMBY_FUSE_PREFIXES=/mnt/mp/,/mnt/paul/
# EA 进程认领自己属于哪个"服"（默认空；slug 或 id；REALM 的备用键；未设置则不做服过滤）
#SERVER_REALM=
# EM 向 EA 拉取挂载体检结果的 HTTP 超时（秒，默认 60）
#MOUNT_HEALTH_FETCH_TIMEOUT=60
# EM 调节点 API（体检逐条挂载等）的默认超时（秒，默认 60）
#NODE_IO_TIMEOUT=60
# 订阅到期提醒调度器执行周期（秒，默认 3600=1h，下限 300；档位按天算，跑再密也不会多发）
#REMINDER_INTERVAL=3600
# worker 心跳上报间隔（秒，默认 30，最小 5）
#WORKER_HEARTBEAT_INTERVAL_SEC=30
# worker 等分布式锁的最大等待（秒，默认 45，最小 0）
#WORKER_LOCK_WAIT_SEC=45
# 启动期 SA token 预铸在启动后先延迟这么久再执行（秒，默认 60.0；避开启动期维护任务抢资源）
#SA_PREMINT_STARTUP_DELAY_SECONDS=60.0
# 启动期 SA token 预铸的错峰间隔（秒，默认 180.0；避免 100 个 RSA 签名+HTTPS POST 集中打满 CPU）
#SA_PREMINT_STAGGER_SECONDS=180.0
#
# ---- 脚本与排障（生产运行时用不到）----
# E2E 测试脚本创建员工账号时用的用户名（默认 boss；仅 scripts/_e2e_mkstaff.py 用）
#E2E_STAFF_USER=boss
# SQLite→PG 一次性迁移脚本的目标库连接串（未设则脚本报错退出；可被 --target 覆盖；含密码勿写命令行历史）
#PG_TARGET_URL=
# EA 进程启动 Python 内存分配追踪（默认 0；TRACEMALLOC=1 时追踪 25 层栈，内存泄漏排查用 /debug/tracemalloc/top）
#TRACEMALLOC=0
# EA 进程的日志级别（默认 info；backend 主服务固定 INFO，不读此键）
#LOG_LEVEL=info
#
# ---- 探测参数（ffprobe/mediainfo）----
# ffprobe -analyzeduration 参数（微秒，默认 10000000=10 秒；范围 1000~2^40；分析流信息的最大时长预算）
#FFPROBE_ANALYZEDURATION=10000000
# ffprobe -probesize 参数（字节，默认 10485760=10MB；范围 1024~2^34；探测读取字节上限）
#FFPROBE_PROBESIZE=10485760
# mediainfo JSON 持久化统一落盘目录（默认 /data/mediainfo；按 guid 两位分片存 -mediainfo.json）
#MEDIAINFO_JSON_DIR=/data/mediainfo
# mediainfo JSON 持久化模式（默认 1；0=关；1=探完就存+恢复时读；restore-only=只读不写）
#MEDIAINFO_PERSIST_MODE=1
#
# ---- 媒体条目软删除 ----
# 媒体条目软删除开关（默认 1=开；=0 时启动时把已隐藏条目复活、回到硬删行为）
#MEDIA_SOFT_DELETE=1
# 软删除隐藏多少天之后才真正物理删除（天，默认 30；0=永不自动清理；非法值回落 30）
#MEDIA_SOFT_DELETE_PURGE_DAYS=30
#
# ---- 分类取值（facets）----
# 分类取值（genres/studios/tags/platforms）回填每批条数（默认 2000）
#ITEM_FACETS_BACKFILL_BATCH=2000
# 分类取值进程内缓存 TTL（秒，默认 600；兜底，扫描/回填会主动失效）
#ITEM_FACETS_CACHE_TTL=600
# 筛选路径里一次最多补回填的条数（默认 2000；避免读请求被回填拖住）
#ITEM_FACETS_FILTER_BUDGET=2000
#
# ---- 文件监听 ----
# fs 监听器周期性对账间隔（秒，默认 900，下限 60；非法值回落 900；只重建监听集合、不遍历目录，用于补 inotify 漏事件）
#FS_RECONCILE_INTERVAL_SEC=900
# 单个监听路径的子目录数上限（默认 2000，下限 100；非法值回落 2000；超过则该路径降级为定时扫描）
#FS_WATCH_MAX_SUBDIRS=2000
# 前台活跃判定窗口秒数（默认 60；扫描让路/预热相关逻辑用）
#FOREGROUND_ACTIVE_SECONDS=60
#
# ---- 健康快照 ----
# /api/health 等健康快照的进程内缓存 TTL（秒，默认 60.0；<=0 关闭缓存；非法值回落 60）
#HEALTH_REPORT_TTL_SECONDS=60.0
#
# ---- API 网关 ----
# 请求体最大 MB 数（默认 10；超限拒绝；EM 与 EA 各自读）
#MAX_REQUEST_BODY_MB=10
#
# ---- 出站代理（续：标准变量，管理后台写入）----
# 标准 HTTP/HTTPS 代理环境变量（默认空；**由管理后台「网络代理」配置写入/清除，一般不用手动配**；httpx 等标准库在构造 client 时读取）
#HTTP_PROXY=
#HTTPS_PROXY=
#
# ---- 远端挂载 / 扫描 / 探测（r58 配置纪律审计补文档：以下键后端在读，但此前无处可查）----
# 同一远程挂载同时只允许一个扫描任务（默认 1=开；0=关闭串行化，不建议）
#EMBY_SCAN_MOUNT_SERIAL=1
# rclone 可执行文件路径（默认 rclone）
#MOUNT_RCLONE_BIN=rclone
# rclone.conf 路径（默认 /config/rclone/rclone.conf；compose 已挂载，后台粘贴的配置写这里；与 Drive Changes 轮询读的是同一文件）
#MOUNT_RCLONE_CONF=/config/rclone/rclone.conf
# rclone RC 地址（代码默认 http://127.0.0.1:5572；compose 里配的是 http://rclone:5572）
#MOUNT_RCLONE_RC_URL=http://127.0.0.1:5572
# 115 Web API 域名（默认 https://webapi.115.com；115 偶调域名时可覆盖，也便于测试指本地假服务）
#PAN115_WEBAPI_BASE=https://webapi.115.com
# 需要探测的条目类型（默认 movie,episode；剧集/季没有文件；只想探电影可设 movie）
#PROBE_ITEM_TYPES=movie,episode

# ==================== 功能开关（2026-10-21 起改走环境变量） ====================
# 下面 46 个开关原先在管理后台里点选，现已摘除面板：默认开的功能开关与调优
# 开关一律走文件配置。不设 = 用每行写的默认值；要改就取消该行注释、改值，
# 重启 api / worker / ea 容器后生效。取值优先级：环境变量 > 数据库存量值 > 默认值。
# 仍留在管理后台的开关不在此列：
# - 默认关（签到、群发言积分、系统告警、访问守卫 UA/归属地、后台登录人机验证、
#   邮件通知、网络代理、媒体库默认范围；备用元数据 altmeta_enabled 向来无面板）；
# - 默认开、服主 2026-10-21 13:53 要求留在面板（定时扫描、追新、豆瓣、推广奖励、
#   流媒体加速、多源总开关、TMDB-miss 兜底、单集夜间刮削、统一兜底、配额制、
#   none/failed 自动回捞、字段级完成口径）。它们照旧存数据库，代码缺省为开。
# 单集夜间刮削仍可读 ENRICH_EPISODE_NIGHT_ONLY（见上方刮削段），显式设置时优先于库。
# 取值照每行默认值的写法填（true/false 或 1/0），不要在值后面加注释。
# AI_ENABLED=true
# BACKUP_ENABLED=1
# BOT_CMD_BIND=true
# BOT_CMD_CHECKIN=true
# BOT_CMD_POINTS=true
# BOT_CMD_REDEEM=true
# BOT_ENABLED=true
# BOT_REDPACKET_ENABLED=true
# CAPTCHA_PROTECT_LOGIN=true
# CAPTCHA_PROTECT_REGISTER=true
# COUPON_ENABLED=true
# DRIVE_DIRECT_PLAY_ENABLED=true
# ENRICH_DOUBAN_BAN_DOWNGRADE=1
# ENRICH_TMDB_BATCH=true
# EXCHANGE_ENABLED=true
# EXPIRY_REMINDER_ENABLED=true
# HOTLINK_PROTECTION_ENABLED=true
# INVITATION_ENABLED=true
# ITEMS_DEDUP_CACHE_ENABLED=true
# ITEMS_LIST_CACHE_ENABLED=true
# LOTTERY_AUTO_DRAW_ENABLED=1
# LOTTERY_ENABLED=1
# LOTTERY_NOTIFY_WINNERS=1
# MEDIA_SEEK_ENABLED=1
# MEDIA_SEEK_NOTIFY_VOTERS=1
# MEDIA_SEEK_VOTE_ENABLED=1
# META_SOURCE_ENABLED_ANILIST=1
# META_SOURCE_ENABLED_BANGUMI=1
# META_SOURCE_ENABLED_DOUBAN=1
# META_SOURCE_ENABLED_OMDB=1
# META_SOURCE_ENABLED_TMDB=1
# META_SOURCE_ENABLED_TVDB=1
# META_SOURCE_ENABLED_TVMAZE=1
# META_SOURCES_PREFER_CHINESE=1
# NEW_MEDIA_NOTIFY_ENABLED=1
# POINTS_AUDIT_ENABLED=true
# POINTS_TRANSFER_ENABLED=1
# REDPACKET_REFUND_ENABLED=true
# REGISTER_RATELIMIT_ENABLED=true
# SERIES_MERGE_ENABLED=1
# SERIES_MERGE_LOOSE_ENABLED=1
# SERIES_MERGE_REQUIRE_YEAR=1
# TEASER_ENABLED=true
# TG_BIND_GUIDE_ENABLED=1
# VITALITY_ENABLED=true
# 识别低置信人工审查队列总开关（1=开，默认 0=关）：开启后 TMDB 真搜过、有候选
# 但无一过置信线的条目，在 enrich 终态 none 的同一事务里入队
# （emby_identify_review_tasks，带候选与分数的证据快照），管理员在后台逐条
# 处置（绑定到指定 TMDB / 忽略 / 重跑识别）；关=行为与现行逐字一致。
# 判据与状态流转唯一实现在 backend/emby_server/identify_review.py。
# 启动时读一次，改这项需重启。
#IDENTIFY_REVIEW_QUEUE_ENABLED=0
# 豆瓣 Frodo 桥（FMBY 批二 #14）：Frodo 客户端 apikey，缺省用豆瓣 App 内置的
# 公开 key，一般不用改；有自备 key 时填这里覆盖。
#DOUBAN_FRODO_APIKEY=
# 豆瓣 Frodo 桥：请求 User-Agent，缺省为移动端 UA；豆瓣改版导致 Frodo 请求
# 被拒时可在此覆盖，不用改代码。
#DOUBAN_FRODO_UA=
# 豆瓣 Frodo 桥：两次请求最小间隔秒数（默认 1.0，0=不限速）；与豆瓣 suggest
# 腿的 douban_min_interval 是两条腿各自的限速，不共用。
#DOUBAN_FRODO_MIN_INTERVAL=1.0
# 播放变体清单下发开关（1=开，默认 0=关）：开启后 PlaybackInfo 按条目真实
# 可用的播放方式（Drive 中继/Drive 直链/挂载中继/本地文件/转码）下发多条
# MediaSource 供客户端自选，第一条恒为现行主线变体、只取第一条的老客户
# 端无感；关闭时下发单源、与旧行为逐字一致（本功能的回滚手段）。变体
# 可用性只看策略开关与条目静态属性，不在清单阶段解析直链；判定读播放
# 策略开关（store 60 秒缓存），变更最长约 60 秒生效。启动时读一次，
# 改这项需重启。判定单口在 backend/emby_server/play_variants.py。
#PLAY_VARIANTS_ENABLED=0
# 扫描目录到期调度（FMBY 学习批二 #12，默认开）：目录清单指纹未变且未到期时
# 整段跳过逐文件核对；关掉（=0）后核对深度回到旧行为（清单指纹 v2 仍生效）。
#SCAN_DIR_DUE_SCHEDULING=1
# 目录到期周期（秒，默认 86400=24 小时，钳制 300–2592000）：目录完整核对一次后，
# 隔多久再到期重验（到期重刮等「到期才做」的判定在这时才重新评估）。
#SCAN_DIR_RECHECK_SEC=86400
# 按源目录快照层（任务清单第 11 项，默认开）：扫描目录指纹按源行（library_sources）
# 维度落快照表（directory_scan_snapshots），同一库多源时各源目录互不干扰；关掉（=0）
# 后只走旧的按库指纹表（emby_scan_dirs），行为与旧版逐字一致。
#SCAN_SOURCE_SNAPSHOT_ENABLED=1
# 一等播放会话开关（FMBY 播放全换阶段 3，默认 0=关）：开启后 PlaybackInfo
# 返回服务端预建的会话 id（上报/停播/租约同身份），关闭时返回随机票据、
# 与旧行为逐字一致。改这项需重启。
#PLAY_SESSION_FIRST_CLASS_ENABLED=0
# 兼容层令牌有效期（天，默认 30）：新签发的 emby_api_tokens 过期天数。
# FMBY 兼容会话 180 天未经我方真实播放器隔期复验，不作默认值；服主如需
# 长效可自行改大（改后重启生效），被盗令牌窗口随之放大。
#EMBY_TOKEN_TTL_DAYS=30
# 上游源探活与 availability_status（FMBY 学习 #25 25-3，源级；默认关）：
# 开关关时工人不发任何请求、不写任何状态，全站行为逐字不变。状态语义按
# FMBY 实测口径：无记录当 Active、Unknown 不覆盖已知、成功复位计数与隐藏、
# 连续失败达阈值才翻 Unavailable（见 backend/emby_server/upstream_health.py）。
# 下列周期/阈值/超时/退避上限的默认值是“我方起步值”，FMBY 探活阈值与间隔
# 在深挖中没有实测到常量——待复验/待裁定，主代理裁定前不得视为 FMBY 口径。
#UPSTREAM_HEALTH_PROBE_ENABLED=0
#UPSTREAM_HEALTH_PROBE_INTERVAL_SEC=60
#UPSTREAM_HEALTH_FAILURE_THRESHOLD=3
#UPSTREAM_HEALTH_PROBE_TIMEOUT_SEC=5
#UPSTREAM_HEALTH_BACKOFF_MAX_SEC=600
# 播放实时总线（FMBY 学习 #24 前半，骨架 + 快照 + 命令表，只做 stop；默认关）：
# 开关关时发布、快照、命令入口全部不执行，全站行为逐字不变。频道名用我方
# 自定版本化名 aetrix:playback:realtime:v1（FMBY 频道名深挖中未实测证实，
# 见 backend/emby_server/playback_bus.py 的诚实边界说明，不冒充人家实测值）。
# 快照间隔 15 秒、命令超时 10 秒均为我方起步值。
#PLAYBACK_BUS_ENABLED=0
#PLAYBACK_BUS_SNAPSHOT_INTERVAL_SEC=15
#PLAYBACK_BUS_COMMAND_TIMEOUT_SEC=10
# 挂载凭据 KEK 目录（FMBY 挂载模型地基，清单第 1 项；默认关、无行为）：
# 信封加密的 KEK（密钥加密密钥）文件目录，约定为服务器上的 /data/secrets
# （如 pan115-kek.b64 同款命名法）。路径只从部署配置读，代码里不设
# 默认值；未设置时 KEK 信封不可用（地基阶段不做 KEK 信封操作，该能力
# 是清单第 4 步）。KEK 材料本身绝不进仓库、不进 env.example，只放服务器文件。
#MOUNT_KEK_DIR=/data/secrets
# 媒体库列表投影读模型（FMBY 列表投影读模型，清单第 16 项试点）：
# 试点只切 user_views（客户端媒体库列表页）：条目数/最早入库/封面 tag
# 预先算好落 emby_library_list_projection 表，读路径一次 IN 查询；
# 缺行/过期/读错/身份门开时整包回落现算，绝不静默出旧数。
# 工人由 worker 进程跑（周期重建），关时读路径走现行现算、行为逐字不变。
#LIST_PROJECTION_ENABLED=1
#LIST_PROJECTION_REFRESH_SEC=120
#LIST_PROJECTION_MAX_STALE_SEC=900
# BYOS 用户存储绑定（P1：绑定管理 + 115 直链播放）：
# 单用户绑定账号上限（走配置不写死；BYOS-2 暂定默认值 3，是 BYOS
# 设计稿建议值、不是 FMBY 值，用户一句话可推翻）。上限计该用户
# 全部绑定行（含失败态），超了须先解绑不用的账号。
#BYOS_BINDING_LIMIT_PER_USER=3
# 上游健康落库（FMBY #25 清单第 14 项：25-3 Redis 状态 → PG health_status）：
# 翻译唯一口径 Active→healthy、Unavailable→unhealthy、无记录→unknown；
# 同步默认关（探活守护本身未接线时无记录可搬），周期同步入口
# start_health_sync_daemon 须显式调用才跑；同步失败只记警告、不改 25-3 判定。
#UPSTREAM_HEALTH_PG_SYNC_ENABLED=0
#UPSTREAM_HEALTH_PG_SYNC_INTERVAL_SEC=60
# 变体级可用性落库 + 真探活（FMBY 播放阶段 4，清单第 4 项；默认关）：
# 开关关时工人不发任何请求、不写任何状态；本阶段只落库 + 只探活，
# 不接调度（变体清单与 video_stream 选路一律不动），可用性表只是
# “看得见的状态”，调度按它过滤是阶段 6/7 的事。探活 = 真实解析 +
# Range bytes=0-0 试读（只读 1 字节、不搬字节），目标取自最近成功起播
# 事件（只探用户真在用的路径）；local_file 不探。
# 下列周期/阈值/超时/上限/窗口的默认值是“我方起步值”，FMBY 探活阈值与
# 间隔在深挖中没有实测到常量——待裁定，不得视为 FMBY 口径。
#VARIANT_AVAILABILITY_PROBE_ENABLED=0
#VARIANT_AVAILABILITY_PROBE_INTERVAL_SEC=300
#VARIANT_AVAILABILITY_FAILURE_THRESHOLD=3
#VARIANT_AVAILABILITY_PROBE_TIMEOUT_SEC=10
#VARIANT_AVAILABILITY_MAX_TARGETS_PER_CYCLE=20
#VARIANT_AVAILABILITY_PROBE_WINDOW_HOURS=24
