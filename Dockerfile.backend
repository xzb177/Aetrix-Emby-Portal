# syntax=docker/dockerfile:1
# 后端专用镜像：只含 Python 后端，不打包前端静态文件。
# 前端由 Dockerfile.frontend 单独构建，走 nginx 容器 serve。
#
# ==================== 发行镜像：白名单拷贝 ====================
# 这个镜像要发给买授权的客户，他们**看不到源码**。所以这里用白名单 COPY，
# 而不是 `COPY . /app`：黑名单（.dockerignore）永远漏得掉东西 —— 新加一个顶层
# 目录、忘了往 .dockerignore 里补，它就跟着进镜像了。白名单则是「不加进来就是
# 不进来」，新增目录默认安全。
#
# 白名单的每一条都对应「运行时真的会去读这个路径」，不是随手列的：
#   backend/    FastAPI 应用本体（main.py / api/ / emby_server/ / assets/ ...）
#   emby_api/   自建 Emby 服务端。backend/run_all.py 用 `python -m emby_api.main`
#               拉起它 —— 这条是字符串拼出来的命令，静态搜 import 搜不到，
#               漏了它容器起来就只剩一个进程、EA 直接崩。
#   web_player/ 单文件看片页。emby_api/main.py 按 `parent.parent/"web_player"`
#               定位它，漏了 /watch 会 404（手机浏览器看片直接不可用）。
#   serve.py    run_all.py 的 api 子进程入口（uvicorn backend.main:app）
#   VERSION     backend/version.py 按 `parent.parent/"VERSION"` 读，漏了版本号
#               会退化成 dev，/api/health 报的版本是假的
#
# base 里刻意**不带**：.git、前端 TS 源码、tests/、docs/、venv/、*.db，
# 也不带 scripts/（只有 with-scripts target 才补它，见下）。
# 要动这份白名单前，先确认没有别处还在读被排除的路径：
#   grep -rn "parent.parent\|parents\[" backend/ emby_api/ serve.py
#
# ==================== 三个 stage 的排布（别改顺序）====================
# base          白名单拷贝的成品 —— 客户拿到的就是它
# with-scripts  在 base 之上补 scripts/，给自建部署做运维（见下）
# runtime       空 stage，只是 `FROM base`，**必须放在最后**
#
# 为什么最后要挂一个空壳：`docker build` 不带 `--target` 时构建的是**最后一个
# stage`，不是第一个也不是名字带 release 的那个。所以只要 with-scripts 排在末尾，
# 「不带 --target 的 docker build」就会静默产出带 scripts/ 的镜像 —— 而这正是
# 隐藏地雷的形状：构建不报错、镜像正常起来，只是内容不对。push 之后 ghcr 的 latest
# 被覆盖，客户随时可能拉，没法悄悄撤回。
#
# 末尾这个空收尾让默认值恰好也是精简版；发布脚本（publish-images.yml）**另外**
# 显式写 `--target runtime`，不依赖这个「恰好」。两道保险，顺序上安全的那个是默认的。

# 基础镜像必须钉住 Debian 大版本（-bookworm 后缀），不能用浮动的 -slim：
# 2026-10-13 实锤——python:3.12-slim 标签已漂到 trixie，而下面的 PGDG 源写的是
# bookworm-pgdg，pgdg12 的 libpq5 在 trixie 上依赖无解（libldap-2.5-0 不存在），
# 导致生产构建 apt exit 100。CI 能过是因为 runner 缓存了旧的 bookworm 层。
FROM python:3.12-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update \
    # r43：tzdata 装包时会弹 debconf 时区交互，非交互模式否则 docker build 卡住
    && export DEBIAN_FRONTEND=noninteractive \
    && apt-get install -y --no-install-recommends ffmpeg mediainfo ca-certificates curl gnupg tzdata libvips42 \
    && rm -rf /var/lib/apt/lists/*
# pg_dump 供 db_backup 的 PostgreSQL 分支用（E-P1-4）：生产库是 postgres:16，
# 定时/手动备份在容器内直接调 pg_dump。客户端大版本必须与服务端对齐（16），
# Debian bookworm 自带的 postgresql-client 是 15，故走 PGDG 官方源取 16。
RUN install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt
# 版本号单一来源：显式先放一份，避免将来白名单调整时漏掉它
COPY VERSION /app/VERSION
# 媒体库封面渲染用的中文字体（Noto Sans SC，SIL OFL 1.1）。
# 显式 COPY 而不是只指望下面那行 `COPY backend/`：将来白名单或 .dockerignore
# 加了 *.ttf / **/assets 之类规则时，这里会先失败并让构建停下，而不是
# 悄悄产出一个字体缺失、封面不出字的镜像。
COPY backend/assets/fonts /app/backend/assets/fonts

# ---- 白名单拷贝（顺序无所谓，两个目录之间无 import 依赖）----
COPY backend/ /app/backend/
COPY emby_api/ /app/emby_api/
COPY web_player/ /app/web_player/
COPY serve.py /app/serve.py

# 密钥一个都不打进镜像：SECRET_KEY / 数据库口令 / 各家 API Key 全走运行时环境变量
# （compose 的 env_file / environment）。backend/__init__.py 那个 load_dotenv 读的
# 是 /app/.env，而 .env 被 .dockerignore 排除 —— 镜像里根本不存在这个文件。
#
# 注：这里刻意**没有**切到非 root 跑。compose 里有三个 rw 挂载（/data 转码、
# /config/rclone 面板写配置、/sa-accounts 服务账号 JSON），而 named volume 由 Docker
# 以 root:root 755 创建（实测：uid 10001 对 named volume touch → Permission denied）。
# 切非 root 会让转码和挂载面板当场失效。要做这个加固得先在 Dockerfile 里给那些
# 挂载点建目录并 chown，或给 volume 配 uid —— 那是另一个独立的改动。

# 注意：不 COPY 前端 dist。FRONTEND_DIST/ADMIN_DIST 留空时
# backend/main.py 会跳过静态文件挂载，只跑 API。
ENV HOST=0.0.0.0 \
    PORT=8000 \
    ENABLE_EMBY_GATEWAY=true \
    EMBY_FFMPEG_PATH=ffmpeg
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
CMD ["python", "serve.py"]

# ==================== 运维变体：带 scripts/ ====================
# 给**自建/开发**部署用：docker exec 进容器跑运维脚本（造管理员、迁移库、
# 冒烟、备份恢复…），不必在宿主上再装一遍 Python 环境。
#
# 为什么这些脚本在容器里能直接跑：它们普遍以
#   ROOT = Path(__file__).resolve().parent.parent
#   sys.path.insert(0, str(ROOT))
# 定位项目根。放进 /app/scripts/ 后 ROOT 正好是 /app，而白名单已经把 backend/
# 放在了 /app/backend/ —— 两边对得上，不需要为容器改任何一行脚本代码。
# 依赖同样对得上：scripts/*.py 用到的第三方库（fastapi / httpx / sqlalchemy /
# starlette / uvicorn）全在 backend/requirements.txt 里，pip 那一步两个变体共用。
#
# 注意有 scripts 依赖宿主环境、容器里跑不了的（backup.sh 一类按 venv/bin/python
# 找解释器、enrich_backlog_report.py 读仓库相对路径）。带进来是为了「能跑的那些
# 都在手边」，不是承诺每一条都等价 —— 要跑完整的备份流程仍按 DEPLOY.md 走宿主。
FROM base AS with-scripts
COPY scripts/ /app/scripts/

# ==================== 发行变体：默认产物 ====================
# 见文件头的「三个 stage 的排布」。保持空，不要往这里加 COPY。
FROM base AS runtime
